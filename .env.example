# ==============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Hugging Face
# ------------------------------------------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
# Required for: Private models, gated datasets, pushing to Hub
HF_TOKEN=

# ------------------------------------------------------------------------------
# Weights & Biases
# ------------------------------------------------------------------------------
# Get your API key from: https://wandb.ai/authorize
# Required for: Experiment tracking, artifact logging, hyperparameter sweeps
WANDB_API_KEY=
WANDB_PROJECT=llm-finetuning
WANDB_ENTITY=your-username-or-team
WANDB_MODE=online  # online, offline, disabled

# ------------------------------------------------------------------------------
# OpenAI (for MT-Bench evaluation judge)
# ------------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required for: MT-Bench LLM-as-judge evaluation
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORG_ID=

# ------------------------------------------------------------------------------
# CUDA / GPU Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of GPU IDs to use (e.g., "0", "0,1", "1,2,3")
CUDA_VISIBLE_DEVICES=0

# PyTorch CUDA memory allocation configuration
# Helps with memory fragmentation on large models
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# ------------------------------------------------------------------------------
# Training Configuration
# ------------------------------------------------------------------------------
# Override training config values via environment (optional)
# TRAINING_NUM_EPOCHS=3
# TRAINING_BATCH_SIZE=4
# TRAINING_LEARNING_RATE=2e-4
# TRAINING_LORA_R=64
# TRAINING_LORA_ALPHA=16

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json, text

# ------------------------------------------------------------------------------
# Hugging Face Hub (for pushing models)
# ------------------------------------------------------------------------------
# HF_HUB_ENABLE_HF_TRANSFER=1  # Enable hf_transfer for faster downloads
# HF_ENDPOINT=https://hf-mirror.com  # Use mirror if needed

# ------------------------------------------------------------------------------
# Network / Proxy (if behind corporate firewall)
# ------------------------------------------------------------------------------
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.company.com

# ------------------------------------------------------------------------------
# Docker / Container
# ------------------------------------------------------------------------------
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1

# ------------------------------------------------------------------------------
# Development
# ------------------------------------------------------------------------------
# JUPYTER_TOKEN=your-secure-token
# DEBUG=true